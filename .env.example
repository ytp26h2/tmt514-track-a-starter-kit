# 複製成 .env 再填（.env 已經在 .gitignore 裡，不會被 commit）
#   cp .env.example .env

# anthropic | openai | dry-run（預設；不呼叫 LLM，回傳範例資料）
LLM_PROVIDER=dry-run
# 模型名稱：anthropic 預設 claude-sonnet-5-5；openai 相容服務必填
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 任何 OpenAI 相容服務，例如本機 Ollama：http://localhost:11434/v1
OPENAI_BASE_URL=

# 單次 LLM 呼叫的逾時秒數
LLM_TIMEOUT=60

# 後端埠號（改了的話，Chrome 外掛的 SERVER 與 host_permissions、VS Code 的 ytp.serverUrl 也要改）
PORT=8787
# 額外允許呼叫後端的網頁來源，逗號分隔，例如 Vite 開發伺服器
ALLOWED_ORIGINS=
# C++ 編譯器與參數（macOS 想用 <bits/stdc++.h>：brew install gcc 後設 CXX=g++-14）
CXX=g++
CXXFLAGS=-O2 -std=c++17
# 資料包：預設 data/cf1000-v0.1（1000 題）；10 題的小資料包是 data/sample-v0.1；12/12 換成正式資料包
DATAPACK=data/cf1000-v0.1
