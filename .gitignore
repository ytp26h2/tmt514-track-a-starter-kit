# ytp26h2 預設 .gitignore（可自行增修）
.env
.env.*
*.key
*.pem
node_modules/
__pycache__/
*.pyc
.venv/
venv/
dist/
build/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
# 大型檔案請勿入庫
*.pt
*.bin
*.mp4
*.zip

# ---- starter kit ----
# 上面的 .env.* 會連 .env.example 一起忽略，這份範本要留在 repo 裡
!.env.example
# 編譯產物與範例執行時產生的本機資料
.build/
*.db
log.jsonl
attempts/
out/
*.vsix
